# Google OAuth for Gmail transaction import.
#
# Copy to `.env` (already gitignored) and fill in the client IDs you create in
# Google Cloud. Only the ID for the platform you are running is required.
#
# These are PUBLIC identifiers, not secrets. Never put a client secret here --
# a secret shipped inside a mobile app is recoverable by anyone who unpacks it.
# Tokens are stored at runtime in the iOS Keychain / Android Keystore via
# expo-secure-store, not in this file.

# iOS native client (must match your bundle identifier)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android native client (must match your package name)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web client (must allow the redirect URI Expo AuthSession generates)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=