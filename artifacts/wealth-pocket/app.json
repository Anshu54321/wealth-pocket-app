{
  "expo": {
    "name": "Mira — Personal Finance",
    "slug": "wealth-pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wealth-pocket",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F7FB",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Mira uses Face ID to protect access to your finance dashboard."
      }
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_SMS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store",
      ["expo-notifications", { "color": "#00C08B" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
